<UserControl x:Class="SaraBI.Controls.AddViewPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI" FontSize="12">
  <Border Background="#F7F7F7" BorderBrush="#D4D4D4" BorderThickness="1,0,0,0">
    <DockPanel>
      <Border DockPanel.Dock="Top" Background="#1A5C38" Padding="10,8">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="✕" Width="22" Height="22"
                  Background="Transparent" Foreground="White" BorderThickness="0"
                  Cursor="Hand" Click="OnClose" ToolTip="Cerrar"/>
          <TextBlock Text="Agregar vista" Foreground="White" FontWeight="SemiBold"
                     VerticalAlignment="Center"/>
        </DockPanel>
      </Border>

      <TextBlock DockPanel.Dock="Top" Margin="10,8,10,4" TextWrapping="Wrap"
                 Foreground="#4B5563" FontSize="11"
                 Text="Seleccione una vista para abrirla como otra hoja de este libro. Se cargan de una en una."/>

      <Grid DockPanel.Dock="Top" Height="28" Margin="10,4,10,8">
        <TextBox x:Name="SearchBox" Height="28" Padding="8,4" VerticalContentAlignment="Center"
                 TextChanged="OnSearch"/>
        <TextBlock x:Name="SearchHint" Text="Buscar vistas..." Foreground="#9CA3AF"
                   Margin="10,6,0,0" IsHitTestVisible="False"/>
      </Grid>

      <TextBlock x:Name="StatusText" DockPanel.Dock="Top" Margin="10,0,10,8"
                 Foreground="#6B7280" FontSize="11" Text="Cargando vistas..."/>

      <ListBox x:Name="ViewList" BorderThickness="0" Background="Transparent"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               MouseDoubleClick="OnItemActivate">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Button Click="OnPick" Tag="{Binding}"
                    Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                    Padding="8,7" Cursor="Hand" Margin="0,0,0,1"
                    IsEnabled="{Binding Enabled}">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding ColumnCount, StringFormat='{}{0} cols'}"
                           Foreground="#9CA3AF" FontSize="10.5" VerticalAlignment="Center"
                           Margin="8,0,0,0"/>
                <StackPanel>
                  <TextBlock Text="{Binding ViewName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding SchemaDisplay}" Foreground="#6B7280" FontSize="11"/>
                </StackPanel>
              </DockPanel>
            </Button>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </Border>
</UserControl>
