<Window x:Class="SaraBI.Dialogs.ExcelAutoFilterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:SaraBI.Models"
        Title="Filtro"
        Width="280" Height="460"
        MinWidth="240" MinHeight="320"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        ShowActivated="True"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI"
        FontSize="12"
        Background="White"
        BorderBrush="#8A8A8A"
        BorderThickness="1"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        PreviewKeyDown="OnPreviewKeyDown">
  <Window.Resources>
    <Style x:Key="FilterMenuItem" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="#212121"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#E8E8E8"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#A6A6A6"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="FilterActionBtn" TargetType="Button">
      <Setter Property="MinWidth" Value="76"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Background" Value="#F5F5F5"/>
      <Setter Property="BorderBrush" Value="#ADADAD"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsDefault" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#217346"/>
                <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#E6E6E6"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#A6A6A6"/>
                <Setter TargetName="Bd" Property="Background" Value="#F5F5F5"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="#D4D4D4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="DateTab" TargetType="RadioButton">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="#6B7280"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Padding" Value="8,8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    BorderBrush="Transparent" BorderThickness="0,0,0,2"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#F3F4F6"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="#217346"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="#217346"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ShortcutBtn" TargetType="Button" BasedOn="{StaticResource FilterActionBtn}">
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="Margin" Value="0,0,6,6"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
  </Window.Resources>

  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="0,4,0,0">
      <Button Style="{StaticResource FilterMenuItem}" Click="OnSortAsc">
        <DockPanel>
          <TextBlock Text="A↓" Width="22" FontWeight="SemiBold" Foreground="#217346"
                     VerticalAlignment="Center"/>
          <TextBlock Text="Ordenar de A a Z" VerticalAlignment="Center"/>
        </DockPanel>
      </Button>
      <Button Style="{StaticResource FilterMenuItem}" Click="OnSortDesc">
        <DockPanel>
          <TextBlock Text="Z↓" Width="22" FontWeight="SemiBold" Foreground="#217346"
                     VerticalAlignment="Center"/>
          <TextBlock Text="Ordenar de Z a A" VerticalAlignment="Center"/>
        </DockPanel>
      </Button>

      <Rectangle Height="1" Fill="#E0E0E0" Margin="0,4"/>

      <Button x:Name="ClearFilterBtn" Style="{StaticResource FilterMenuItem}" Click="OnClear">
        <DockPanel>
          <TextBlock Text="✕" Width="22" Foreground="#6B7280" VerticalAlignment="Center"/>
          <TextBlock x:Name="ClearFilterText" Text="Borrar filtro" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis"/>
        </DockPanel>
      </Button>

      <Button x:Name="TextFiltersBtn" Style="{StaticResource FilterMenuItem}"
              Click="OnTextFiltersClick" MouseEnter="OnTextFiltersHover">
        <Button.ContextMenu>
          <ContextMenu x:Name="TextFiltersMenu" Placement="Right"
                       Closed="OnTextFiltersMenuClosed">
            <MenuItem Header="Es igual a..." Tag="Equals" Click="OnTextOperator"/>
            <MenuItem Header="No es igual a..." Tag="NotEquals" Click="OnTextOperator"/>
            <Separator/>
            <MenuItem Header="Empieza por..." Tag="StartsWith" Click="OnTextOperator"/>
            <MenuItem Header="Termina en..." Tag="EndsWith" Click="OnTextOperator"/>
            <Separator/>
            <MenuItem Header="Contiene..." Tag="Contains" Click="OnTextOperator"/>
            <MenuItem Header="No contiene..." Tag="NotContains" Click="OnTextOperator"/>
          </ContextMenu>
        </Button.ContextMenu>
        <DockPanel>
          <TextBlock Text="›" DockPanel.Dock="Right" Foreground="#6B7280" Margin="8,0,0,0"
                     VerticalAlignment="Center"/>
          <TextBlock Text="Aa" Width="22" Foreground="#217346" FontWeight="SemiBold"
                     VerticalAlignment="Center"/>
          <TextBlock Text="Filtros de texto" VerticalAlignment="Center"/>
        </DockPanel>
      </Button>

      <Border x:Name="TextFilterPanel" Margin="8,4,8,2" Padding="6,5" Background="#F7F7F7"
              BorderBrush="#D4D4D4" BorderThickness="1" Visibility="Collapsed">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="✕" Width="20" Height="20" Margin="4,0,0,0"
                  Background="Transparent" BorderThickness="0" Cursor="Hand"
                  Click="OnClearTextFilter" ToolTip="Quitar filtro de texto"/>
          <StackPanel>
            <TextBlock x:Name="TextOperatorLabel" FontSize="11" Foreground="#616161"
                       Text="Contiene"/>
            <TextBox x:Name="TextValueBox" Height="22" Padding="4,2" Margin="0,3,0,0"
                     TextChanged="OnTextValueChanged"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <Grid x:Name="DateTabs" Margin="0,4,0,0" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <RadioButton x:Name="TabJerarquia" Grid.Column="0" Style="{StaticResource DateTab}"
                     Content="Jerarquía" GroupName="DateMode" IsChecked="True"
                     Checked="OnDateTabChanged"/>
        <RadioButton x:Name="TabRango" Grid.Column="1" Style="{StaticResource DateTab}"
                     Content="Rango" GroupName="DateMode" Checked="OnDateTabChanged"/>
      </Grid>

      <Rectangle Height="1" Fill="#E0E0E0" Margin="0,0,0,6"/>

      <Grid x:Name="SearchRow" Margin="8,0,8,6">
        <TextBox x:Name="SearchBox" Height="24" Padding="6,3"
                 TextChanged="OnSearchChanged"/>
        <TextBlock x:Name="SearchPlaceholder" Text="Buscar" Foreground="#A0A0A0"
                   IsHitTestVisible="False" VerticalAlignment="Center" Margin="10,0,0,0"/>
      </Grid>

      <StackPanel x:Name="RangePanel" Margin="8,0,8,8" Visibility="Collapsed">
        <TextBlock Text="Desde" FontSize="11" Foreground="#374151" Margin="0,0,0,3"/>
        <DatePicker x:Name="FromPicker" Margin="0,0,0,10"
                    CalendarOpened="OnDatePickerOpened" CalendarClosed="OnDatePickerClosed"
                    SelectedDateChanged="OnRangeChanged"/>
        <TextBlock Text="Hasta" FontSize="11" Foreground="#374151" Margin="0,0,0,3"/>
        <DatePicker x:Name="ToPicker" Margin="0,0,0,10"
                    CalendarOpened="OnDatePickerOpened" CalendarClosed="OnDatePickerClosed"
                    SelectedDateChanged="OnRangeChanged"/>
        <WrapPanel>
          <Button Content="Hoy" Style="{StaticResource ShortcutBtn}" Width="118" Click="OnRangeShortcut" Tag="today"/>
          <Button Content="Ayer" Style="{StaticResource ShortcutBtn}" Width="118" Click="OnRangeShortcut" Tag="yesterday"/>
          <Button Content="Esta semana" Style="{StaticResource ShortcutBtn}" Width="118" Click="OnRangeShortcut" Tag="thisWeek"/>
          <Button Content="Semana pasada" Style="{StaticResource ShortcutBtn}" Width="118" Click="OnRangeShortcut" Tag="lastWeek"/>
          <Button Content="Este mes" Style="{StaticResource ShortcutBtn}" Width="118" Click="OnRangeShortcut" Tag="thisMonth"/>
          <Button Content="Mes pasado" Style="{StaticResource ShortcutBtn}" Width="118" Click="OnRangeShortcut" Tag="lastMonth"/>
          <Button Content="Este año" Style="{StaticResource ShortcutBtn}" Width="118" Click="OnRangeShortcut" Tag="thisYear"/>
          <Button Content="Año pasado" Style="{StaticResource ShortcutBtn}" Width="118" Click="OnRangeShortcut" Tag="lastYear"/>
        </WrapPanel>
        <TextBlock x:Name="RangeSummary" Margin="0,4,0,0" Padding="8" FontSize="11"
                   Background="#F0FDF4" Foreground="#166534" TextAlignment="Center"
                   Visibility="Collapsed"/>
      </StackPanel>
    </StackPanel>

    <Border DockPanel.Dock="Bottom" Padding="8,6,18,8">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="OkButton" Content="Aceptar" Style="{StaticResource FilterActionBtn}"
                IsDefault="True" Click="OnOk" Margin="0,0,6,0"/>
        <Button Content="Cancelar" Style="{StaticResource FilterActionBtn}"
                Click="OnCancel"/>
      </StackPanel>
    </Border>

    <TextBlock x:Name="HintText" DockPanel.Dock="Top" Margin="8,0,8,4"
               FontSize="11" Foreground="#616161" TextWrapping="Wrap"
               Visibility="Collapsed"/>

    <Border x:Name="ValuesPanel" Margin="8,0,8,4" BorderBrush="#ABABAB" BorderThickness="1" Background="White"
            ToolTip="Doble clic en un valor para ver solo ese">
      <DockPanel>
        <Border x:Name="SelectAllRow" DockPanel.Dock="Top" Background="#FAFAFA"
                BorderBrush="#E8E8E8" BorderThickness="0,0,0,1" Padding="8,5">
          <CheckBox x:Name="SelectAllBox" Content="(Seleccionar todo)"
                    IsThreeState="True" Click="OnSelectAllClick"/>
        </Border>
        <Grid>
          <TreeView x:Name="DateTree" BorderThickness="0" Padding="0,2"
                    Visibility="Collapsed"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling">
            <TreeView.ItemContainerStyle>
              <Style TargetType="TreeViewItem">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Focusable" Value="False"/>
              </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ItemTemplate>
              <HierarchicalDataTemplate DataType="{x:Type models:DateTreeNode}"
                                        ItemsSource="{Binding FilteredChildren}">
                <StackPanel Orientation="Horizontal">
                  <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                            VerticalAlignment="Center" Margin="0,1,6,1"/>
                  <TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontSize="12"/>
                </StackPanel>
              </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
          <ListBox x:Name="ValuesList" BorderThickness="0" Padding="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   VirtualizingPanel.IsVirtualizing="True"
                   VirtualizingPanel.VirtualizationMode="Recycling"
                   MouseDoubleClick="OnValuesDoubleClick">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="0"/>
              <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
              <Setter Property="Focusable" Value="False"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="8,3">
                      <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="#F3F3F3"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <CheckBox Content="{Binding Display}" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                        FontSize="12"/>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        </Grid>
      </DockPanel>
    </Border>
  </DockPanel>
</Window>
