<Window x:Class="SaraBI.Dialogs.ExcelAutoFilterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Filtro"
        Width="280" Height="440"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI"
        Background="White"
        BorderBrush="#217346"
        BorderThickness="1">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#217346" Padding="8,6">
      <TextBlock x:Name="TitleText" Foreground="White" FontWeight="SemiBold" FontSize="12"
                 Text="Filtro"/>
    </Border>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                Margin="8">
      <Button Content="Quitar filtro" Width="90" Margin="0,0,6,0" Click="OnClear"/>
      <Button Content="Cancelar" Width="76" Margin="0,0,6,0" IsCancel="True" Click="OnCancel"/>
      <Button Content="Aceptar" Width="76" IsDefault="True" Click="OnOk"
              Background="#217346" Foreground="White" FontWeight="SemiBold"/>
    </StackPanel>

    <StackPanel DockPanel.Dock="Top" Margin="8,8,8,4">
      <Button Content="Ordenar A → Z" Margin="0,0,0,4" HorizontalAlignment="Stretch"
              Click="OnSortAsc"/>
      <Button Content="Ordenar Z → A" Margin="0,0,0,8" HorizontalAlignment="Stretch"
              Click="OnSortDesc"/>
      <TextBlock Text="Contiene" FontSize="11" Foreground="#616161" Margin="0,0,0,2"/>
      <TextBox x:Name="ContainsBox" Height="24" Padding="4,2" Margin="0,0,0,8"/>
      <TextBlock Text="Buscar en valores" FontSize="11" Foreground="#616161" Margin="0,0,0,2"/>
      <TextBox x:Name="SearchBox" Height="24" Padding="4,2"
               TextChanged="OnSearchChanged"/>
    </StackPanel>

    <TextBlock x:Name="HintText" DockPanel.Dock="Top" Margin="8,0,8,4"
               FontSize="11" Foreground="#616161" TextWrapping="Wrap"
               Text="Buscar en la lista de valores"/>

    <CheckBox x:Name="SelectAllBox" DockPanel.Dock="Top" Margin="8,0,8,4"
              Content="(Seleccionar todo)" Checked="OnSelectAll" Unchecked="OnSelectAll"/>

    <ListBox x:Name="ValuesList" Margin="8,0,8,8" BorderBrush="#D4D4D4"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             VirtualizingPanel.IsVirtualizing="True"
             VirtualizingPanel.VirtualizationMode="Recycling">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <CheckBox Content="{Binding Display}" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                    FontSize="12"/>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
