<Window x:Class="SaraBI.Dialogs.DateFilterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Filtro de fechas requerido"
        Icon="pack://application:,,,/Assets/jadeone.png"
        Height="280" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="#374151"
               Text="Esta vista supera el límite de filas. Elija una columna de fecha y un rango para continuar."/>
    <TextBlock Grid.Row="1" Text="Columna de fecha" FontWeight="SemiBold" Margin="0,0,0,4"/>
    <ComboBox x:Name="ColumnCombo" Grid.Row="2" Margin="0,0,0,12" DisplayMemberPath="Name"/>
    <Grid Grid.Row="3" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <TextBlock Text="Desde" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <DatePicker x:Name="FromPicker"/>
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Text="Hasta (opcional)" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <DatePicker x:Name="ToPicker"/>
      </StackPanel>
    </Grid>
    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Cancelar" Width="100" Margin="0,0,8,0" IsCancel="True" Click="OnCancel"/>
      <Button Content="Aplicar" Width="100" IsDefault="True" Click="OnOk"
              Background="#3B82F6" Foreground="White" FontWeight="SemiBold"/>
    </StackPanel>
  </Grid>
</Window>
