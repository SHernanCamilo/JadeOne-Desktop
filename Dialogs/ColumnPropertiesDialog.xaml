<Window x:Class="SaraBI.Dialogs.ColumnPropertiesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Columna"
        Icon="pack://application:,,,/Assets/jadeone.png"
        Height="248" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Background="#F5F5F5">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Text="Nombre de la columna" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="#1A5C38"/>
    <TextBox x:Name="NameBox" Grid.Row="1" Height="30" Padding="8,4"
             VerticalContentAlignment="Center" FontSize="13" Margin="0,0,0,14"/>
    <TextBlock Grid.Row="2" Text="Tipo de dato" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="#1A5C38"/>
    <ComboBox x:Name="KindCombo" Grid.Row="3" Height="30" Margin="0,0,0,8"
              VerticalContentAlignment="Center" DisplayMemberPath="Label"/>
    <TextBlock Grid.Row="4" Text="Igual que en Excel: el nombre se muestra en el encabezado y el tipo se aplica a toda la columna."
               TextWrapping="Wrap" Foreground="#616161" FontSize="11.5" VerticalAlignment="Top"/>
    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Cancelar" Width="100" Height="30" Margin="0,0,8,0" IsCancel="True"/>
      <Button Content="Aceptar" Width="100" Height="30" IsDefault="True" Click="OnOk"
              Background="#217346" Foreground="White" FontWeight="SemiBold" BorderThickness="0"/>
    </StackPanel>
  </Grid>
</Window>
