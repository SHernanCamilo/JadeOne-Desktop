<Window x:Class="SaraBI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:SaraBI.Controls"
        Title="JadeOne Desktop"
        Icon="pack://application:,,,/Assets/jadeone.png"
        Height="760" Width="1360"
        MinHeight="520" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="#F5F5F5">
  <Window.Resources>
    <DataTemplate x:Key="ExcelColHeaderTemplate">
      <DockPanel LastChildFill="True">
        <Button DockPanel.Dock="Right" Width="18" Height="18" Margin="2,0,1,0"
                Cursor="Hand" Click="OnColumnHeaderFilterClick"
                Background="Transparent" BorderThickness="0" Padding="0">
          <Button.Style>
            <Style TargetType="Button">
              <Setter Property="ToolTip" Value="Filtro de columna"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding Column.(controls:ExcelColumnHeader.FilterActive), RelativeSource={RelativeSource AncestorType=primitives:DataGridColumnHeader}}" Value="True">
                  <Setter Property="ToolTip" Value="Filtro activo — clic para editar"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
          <Path Data="M2,2 L16,2 L10,10 L10,16 L8,16 L8,10 Z"
                Stretch="Uniform" Width="10" Height="10">
            <Path.Style>
              <Style TargetType="Path">
                <Setter Property="Fill" Value="#6B7280"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Column.(controls:ExcelColumnHeader.FilterActive), RelativeSource={RelativeSource AncestorType=primitives:DataGridColumnHeader}}" Value="True">
                    <Setter Property="Fill" Value="#217346"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Path.Style>
          </Path>
        </Button>
        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center" Margin="2,0,0,0"
                   FontWeight="SemiBold" FontFamily="Calibri" FontSize="12"
                   Foreground="#1A5C38"/>
      </DockPanel>
    </DataTemplate>
  </Window.Resources>
  <DockPanel>
    <!-- Title bar -->
    <Border DockPanel.Dock="Top" Background="#217346" Height="44" Padding="10,0,8,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="pack://application:,,,/Assets/jadeone.png" Width="26" Height="26"
                 Margin="0,0,9,0" RenderOptions.BitmapScalingMode="HighQuality"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="TitleText" Text="JadeOne Desktop" Foreground="White"
                       FontSize="13" FontWeight="SemiBold"/>
            <TextBlock x:Name="SubtitleText" Text="Abra una vista desde la plataforma web"
                       Foreground="#BFFFFFFF" FontSize="11"/>
          </StackPanel>
          <Border Margin="10,0,0,0" Padding="9,3" CornerRadius="12" Background="#24FFFFFF"
                  VerticalAlignment="Center">
            <TextBlock x:Name="SavedBadge" Text="Escritorio" Foreground="#E6FFFFFF" FontSize="11"/>
          </Border>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="RefreshButton" Content="Actualizar todo" Style="{StaticResource XlTitleBtn}"
                  Click="OnRefresh" IsEnabled="False"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Ribbon tabs -->
    <Border DockPanel.Dock="Top" Background="#217346" Height="30" Padding="6,0,6,0">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
        <RadioButton x:Name="TabDatos" Style="{StaticResource XlTab}" Content="Datos"
                     GroupName="Ribbon" IsChecked="True" Checked="OnRibbonTab"/>
        <RadioButton x:Name="TabFiltros" Style="{StaticResource XlTab}" Content="Filtros"
                     GroupName="Ribbon" Checked="OnRibbonTab"/>
        <RadioButton x:Name="TabAnalisis" Style="{StaticResource XlTab}" Content="Análisis"
                     GroupName="Ribbon" Checked="OnRibbonTab"/>
      </StackPanel>
    </Border>

    <!-- Ribbon body -->
    <Border DockPanel.Dock="Top" Background="#F5F5F5" Height="78" BorderBrush="#D4D4D4" BorderThickness="0,0,0,1">
      <Grid>
        <StackPanel x:Name="RibbonDatos" Orientation="Horizontal">
          <StackPanel Style="{x:Null}" Margin="8,4,8,2">
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource XlRibbonBtn}" Click="OnRefresh">
                <StackPanel>
                  <TextBlock Text="↻" FontSize="16" Foreground="#217346" HorizontalAlignment="Center"/>
                  <TextBlock Text="Actualizar&#x0a;todo" TextAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="CancelButton" Style="{StaticResource XlRibbonBtn}" Click="OnCancel" IsEnabled="False">
                <StackPanel>
                  <TextBlock Text="■" FontSize="12" Foreground="#C0392B" HorizontalAlignment="Center"/>
                  <TextBlock Text="Cancelar" TextAlignment="Center"/>
                </StackPanel>
              </Button>
            </StackPanel>
            <TextBlock Text="Conexión" FontSize="10.5" Foreground="#757575" HorizontalAlignment="Center"/>
          </StackPanel>
          <Border Width="1" Background="#E0E0E0" Margin="0,8"/>
          <StackPanel Margin="8,4,8,2">
            <Button Style="{StaticResource XlRibbonBtn}" Click="OnAddViewHint">
              <StackPanel>
                <TextBlock Text="＋" FontSize="16" Foreground="#217346" HorizontalAlignment="Center"/>
                <TextBlock Text="Agregar&#x0a;vista" TextAlignment="Center"/>
              </StackPanel>
            </Button>
            <TextBlock Text="Vistas" FontSize="10.5" Foreground="#757575" HorizontalAlignment="Center"/>
          </StackPanel>
          <Border Width="1" Background="#E0E0E0" Margin="0,8"/>
          <StackPanel Margin="8,4,8,2">
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource XlRibbonBtn}" Click="OnShowFiltersTab">
                <StackPanel>
                  <TextBlock Text="☰" FontSize="14" Foreground="#217346" HorizontalAlignment="Center"/>
                  <TextBlock Text="Filtros&#x0a;dinámicos" TextAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button Style="{StaticResource XlRibbonBtn}" Click="OnClearFilters">
                <StackPanel>
                  <TextBlock Text="✕" FontSize="14" Foreground="#217346" HorizontalAlignment="Center"/>
                  <TextBlock Text="Limpiar&#x0a;filtros" TextAlignment="Center"/>
                </StackPanel>
              </Button>
            </StackPanel>
            <TextBlock Text="Filtrar" FontSize="10.5" Foreground="#757575" HorizontalAlignment="Center"/>
          </StackPanel>
          <Border Width="1" Background="#E0E0E0" Margin="0,8"/>
          <StackPanel Margin="8,4,8,2">
            <Button Style="{StaticResource XlRibbonBtn}" Click="OnShowPivot">
              <StackPanel>
                <TextBlock Text="▦" FontSize="16" Foreground="#217346" HorizontalAlignment="Center"/>
                <TextBlock Text="Tabla&#x0a;dinámica" TextAlignment="Center"/>
              </StackPanel>
            </Button>
            <TextBlock Text="Análisis" FontSize="10.5" Foreground="#757575" HorizontalAlignment="Center"/>
          </StackPanel>
        </StackPanel>

        <StackPanel x:Name="RibbonFiltros" Orientation="Horizontal" Visibility="Collapsed" Margin="10,10,10,6">
          <Grid Width="280" VerticalAlignment="Top" Margin="0,0,12,0">
            <TextBox x:Name="SearchBox" Height="28" Padding="8,4" VerticalContentAlignment="Center"
                     TextChanged="OnSearchChanged"/>
            <TextBlock x:Name="SearchHint" Text="Buscar en todas las columnas..."
                       Foreground="#9CA3AF" Margin="10,6,0,0" IsHitTestVisible="False"/>
          </Grid>
          <ComboBox x:Name="FilterColumnCombo" Width="200" Height="28" DisplayMemberPath="Name"
                    VerticalContentAlignment="Center" Margin="0,0,8,0"/>
          <TextBox x:Name="ColumnFilterBox" Width="200" Height="28" Padding="8,4"
                   VerticalContentAlignment="Center" Margin="0,0,8,0"/>
          <Button Content="Filtrar columna" Height="28" Padding="12,0" Click="OnColumnFilter"/>
        </StackPanel>

        <StackPanel x:Name="RibbonAnalisis" Orientation="Horizontal" Visibility="Collapsed">
          <StackPanel Margin="8,4,8,2">
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource XlRibbonBtn}" Click="OnShowPivot">
                <StackPanel>
                  <TextBlock Text="▦" FontSize="16" Foreground="#217346" HorizontalAlignment="Center"/>
                  <TextBlock Text="Tabla&#x0a;dinámica" TextAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button Style="{StaticResource XlRibbonBtn}" Click="OnClearPivot">
                <StackPanel>
                  <TextBlock Text="✕" FontSize="14" Foreground="#217346" HorizontalAlignment="Center"/>
                  <TextBlock Text="Limpiar" TextAlignment="Center"/>
                </StackPanel>
              </Button>
            </StackPanel>
            <TextBlock Text="Tablas dinámicas" FontSize="10.5" Foreground="#757575" HorizontalAlignment="Center"/>
          </StackPanel>
          <Border Width="1" Background="#E0E0E0" Margin="0,8"/>
          <StackPanel Margin="8,4,8,2">
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource XlRibbonBtn}" Click="OnSavePivot" ToolTip="Guarda el diseño de la tabla dinámica en este equipo">
                <StackPanel>
                  <TextBlock Text="▣" FontSize="16" Foreground="#217346" HorizontalAlignment="Center"/>
                  <TextBlock Text="Guardar" TextAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button Style="{StaticResource XlRibbonBtn}" Click="OnOpenSavedPivot" ToolTip="Abre la tabla dinámica guardada de esta vista">
                <StackPanel>
                  <TextBlock Text="▢" FontSize="16" Foreground="#217346" HorizontalAlignment="Center"/>
                  <TextBlock Text="Abrir&#x0a;guardada" TextAlignment="Center"/>
                </StackPanel>
              </Button>
            </StackPanel>
            <TextBlock Text="Este equipo" FontSize="10.5" Foreground="#757575" HorizontalAlignment="Center"/>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Formula bar -->
    <Border DockPanel.Dock="Top" Background="White" Height="24" BorderBrush="#D4D4D4" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="110"/>
          <ColumnDefinition Width="30"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border BorderBrush="#D4D4D4" BorderThickness="0,0,1,0">
          <TextBlock x:Name="CellRefText" Text="A1" VerticalAlignment="Center" Margin="8,0"
                     FontFamily="Calibri" FontSize="12"/>
        </Border>
        <Border Grid.Column="1" BorderBrush="#D4D4D4" BorderThickness="0,0,1,0">
          <TextBlock Text="fx" FontStyle="Italic" FontFamily="Times New Roman" FontSize="13"
                     Foreground="#616161" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBox x:Name="FormulaBox" Grid.Column="2" BorderThickness="0" Padding="8,2"
                 FontFamily="Calibri" FontSize="12.5" IsReadOnly="True"
                 Background="#FAFAFA" Foreground="#9E9E9E"/>
      </Grid>
    </Border>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Background="#217346" Height="24" Padding="8,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="StatusText" Text="Sin datos" Foreground="White" FontSize="11.5" FontWeight="SemiBold"/>
          <TextBlock Text="  ·  " Foreground="#80FFFFFF" FontSize="11.5"/>
          <TextBlock x:Name="MetricsText" Text="— total   — mostrados   0 filtro(s)" Foreground="#EBFFFFFF" FontSize="11.5"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="HintText" Text="1/1 vistas cargadas" Foreground="#CCFFFFFF" FontSize="11.5" Margin="0,0,10,0"/>
          <TextBlock x:Name="ZoomStatus" Text="100%" Foreground="White" FontSize="11.5"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Sheet tabs -->
    <Border DockPanel.Dock="Bottom" Background="#F5F5F5" Height="26" BorderBrush="#D4D4D4" BorderThickness="0,1,0,0">
      <DockPanel>
        <Button DockPanel.Dock="Left" Content="＋" Width="26" Height="26" FontSize="14"
                ToolTip="Nueva tabla dinámica" Background="Transparent" BorderThickness="0"
                Cursor="Hand" Click="OnShowPivot" Foreground="#217346"/>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="SheetTabStrip">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border MinWidth="88" Cursor="Hand" Padding="12,0" Margin="0"
                        MouseLeftButtonDown="OnSheetTabClick" Tag="{Binding}">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Background" Value="#EDEDED"/>
                      <Setter Property="BorderBrush" Value="#D4D4D4"/>
                      <Setter Property="BorderThickness" Value="0,0,1,0"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                          <Setter Property="Background" Value="White"/>
                          <Setter Property="BorderBrush" Value="#217346"/>
                          <Setter Property="BorderThickness" Value="0,3,1,0"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Content="✕" Width="16" Height="16" FontSize="9"
                            Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="6,0,0,0"
                            Foreground="#757575" Click="OnCloseSheetTab" Tag="{Binding}"
                            ToolTip="Eliminar hoja">
                      <Button.Style>
                        <Style TargetType="Button">
                          <Setter Property="Visibility" Value="Collapsed"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPivot}" Value="True">
                              <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Button.Style>
                    </Button>
                    <TextBlock Text="{Binding Name}" FontSize="11.5" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="#616161"/>
                          <Setter Property="FontWeight" Value="Normal"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                              <Setter Property="Foreground" Value="#1A5C38"/>
                              <Setter Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <DockPanel LastChildFill="True" Background="White">
      <controls:PivotPanel x:Name="PivotSidebar" DockPanel.Dock="Right" Width="318"
                           Visibility="Collapsed"
                           ConfigChanged="OnPivotConfigChanged"
                           Closed="OnPivotClosed"
                           Cleared="OnPivotCleared"/>
      <Grid Background="White">
      <Grid.LayoutTransform>
        <ScaleTransform x:Name="GridZoom" ScaleX="1" ScaleY="1"/>
      </Grid.LayoutTransform>

      <DataGrid x:Name="Grid"
                AutoGenerateColumns="True"
                IsReadOnly="True"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                CanUserSortColumns="True"
                CanUserReorderColumns="True"
                EnableRowVirtualization="True"
                EnableColumnVirtualization="True"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.VirtualizationMode="Recycling"
                VirtualizingPanel.ScrollUnit="Pixel"
                HeadersVisibility="All"
                GridLinesVisibility="All"
                HorizontalGridLinesBrush="#D4D4D4"
                VerticalGridLinesBrush="#D4D4D4"
                AlternatingRowBackground="#F7FBF8"
                RowBackground="White"
                FontFamily="Calibri"
                FontSize="12.5"
                FrozenColumnCount="0"
                ClipboardCopyMode="IncludeHeader"
                SelectionUnit="Cell"
                SelectionMode="Extended"
                BorderThickness="0"
                RowHeaderWidth="42"
                ColumnHeaderHeight="28"
                RowHeight="22"
                LoadingRow="OnLoadingRow"
                CurrentCellChanged="OnCurrentCellChanged"
                AutoGeneratingColumn="OnAutoGeneratingColumn"
                PreviewMouseLeftButtonUp="OnPivotOutlineClick">
        <DataGrid.ColumnHeaderStyle>
          <Style TargetType="primitives:DataGridColumnHeader">
            <Setter Property="Background" Value="#E2EFDA"/>
            <Setter Property="Foreground" Value="#1A5C38"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Calibri"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="#A9D08E"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="4,0,2,0"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="ContentTemplate" Value="{StaticResource ExcelColHeaderTemplate}"/>
          </Style>
        </DataGrid.ColumnHeaderStyle>
        <DataGrid.RowHeaderStyle>
          <Style TargetType="primitives:DataGridRowHeader">
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="Foreground" Value="#616161"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderBrush" Value="#D4D4D4"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
          </Style>
        </DataGrid.RowHeaderStyle>
      </DataGrid>

      <Border x:Name="Overlay" Background="#D9FFFFFF" Visibility="Collapsed">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="420">
          <TextBlock x:Name="OverlayTitle" Text="Cargando vista..." FontSize="16"
                     FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,8" Foreground="#1A5C38"/>
          <TextBlock x:Name="OverlayMessage" Text="" Foreground="#4B5563"
                     HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,12"/>
          <ProgressBar x:Name="OverlayProgress" Height="8" IsIndeterminate="True"
                       Foreground="#217346"/>
        </StackPanel>
      </Border>

      <Border x:Name="EmptyState" Background="White">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="480">
          <Image Source="pack://application:,,,/Assets/jadeone.png" Width="72" Height="72"
                 HorizontalAlignment="Center" Margin="0,0,0,14"
                 RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock x:Name="EmptyTitle" Text="JadeOne Desktop" FontSize="18" FontWeight="SemiBold"
                     HorizontalAlignment="Center" Foreground="#1A5C38"/>
          <TextBlock x:Name="EmptyHint" Margin="0,8,0,16" TextWrapping="Wrap" TextAlignment="Center" Foreground="#4B5563"
                     Text="Abra una vista desde JadeOne en el navegador. No ejecute este programa desde Excel ni desde el .exe."/>
          <Button x:Name="EmptyRefreshButton" Content="Actualizar todo" Style="{StaticResource XlGreenBtn}"
                  HorizontalAlignment="Center" Click="OnRefresh"/>
        </StackPanel>
      </Border>
    </Grid>
    </DockPanel>
  </DockPanel>
</Window>
